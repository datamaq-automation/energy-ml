# Configuración de Entorno (Plantilla)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Metadatos del Proyecto
PROJECT_NAME=sistema-backend
VERSION=1.0.0
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["*"]

# Seguridad (Reemplazar en producción con clave generada de al menos 32 bytes)
SECRET_KEY=change-this-insecure-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mediciones: carpeta con un CSV por medidor (instante, potencia_kw)
MEDICIONES_CSV_DIR=data/input

# NILM
NILM_UMBRAL_KW=60
NILM_EPS_KW=8
NILM_MIN_EVENTOS=10
