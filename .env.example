# Configuración de Entorno (Plantilla)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Metadatos del Proyecto
PROJECT_NAME=sistema-backend
VERSION=1.0.0
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["*"]

# Seguridad (Reemplazar en producción con clave generada de al menos 32 bytes)
SECRET_KEY=change-this-insecure-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de Datos
# Telemetría (solo lectura). Ej. con túnel: ssh -L 3306:127.0.0.1:3306 vps
DATABASE_URL=mysql+pymysql://usuario:clave@127.0.0.1:3306/datamaq_telemetry

# NILM
NILM_UMBRAL_KW=60
NILM_EPS_KW=8
NILM_MIN_EVENTOS=10
